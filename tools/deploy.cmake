cmake_minimum_required(VERSION 3.21)

file(LOCK "${CMAKE_CURRENT_LIST_DIR}/../build/deploy.lock" GUARD PROCESS TIMEOUT 60)
file(MAKE_DIRECTORY "${PACKAGE_DIR}")
set(changed)
foreach(source IN ITEMS "${RUNTIME}" "${APP}")
    cmake_path(GET source FILENAME name)
    set(dest "${PACKAGE_DIR}/${name}")
    file(SHA256 "${source}" wanted)
    file(REMOVE "${dest}.pending")
    if(EXISTS "${dest}")
        file(SHA256 "${dest}" current)
        if(current STREQUAL wanted)
            continue()
        endif()
    endif()
    list(APPEND changed "${source}")
endforeach()
if(NOT changed)
    return()
endif()

if(EXISTS "${PACKAGE_DIR}/DiskCleaner.exe")
    find_program(POWERSHELL NAMES pwsh powershell REQUIRED)
    execute_process(COMMAND "${POWERSHELL}" -NoProfile -NonInteractive
        -File "${CMAKE_CURRENT_LIST_DIR}/stop_package_instance.ps1"
        -Executable "${PACKAGE_DIR}/DiskCleaner.exe" COMMAND_ERROR_IS_FATAL ANY)
endif()
foreach(source IN LISTS changed)
    cmake_path(GET source FILENAME name)
    set(dest "${PACKAGE_DIR}/${name}")
    # A sibling temporary file keeps the old image intact if copying fails.
    file(COPY_FILE "${source}" "${dest}.pending" RESULT status)
    if(status STREQUAL "0")
        file(RENAME "${dest}.pending" "${dest}" RESULT status)
    endif()
    if(NOT status STREQUAL "0")
        file(REMOVE "${dest}.pending")
        message(FATAL_ERROR "Could not replace ${dest}: ${status}")
    endif()
endforeach()
